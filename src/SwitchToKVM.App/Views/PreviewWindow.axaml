<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SwitchToKVM.App.ViewModels"
        xmlns:views="using:SwitchToKVM.App.Views"
        x:Class="SwitchToKVM.App.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="SwitchToKVM page preview"
        Icon="/Assets/icon.ico"
        Width="860"
        Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#EFEAF3">

    <Grid ColumnDefinitions="280,*">
        <ListBox ItemsSource="{Binding Scenarios}"
                 SelectedItem="{Binding Selected}"
                 Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PreviewScenario">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1"
                Width="500" Height="520"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                BoxShadow="0 8 24 0 #22000000">
            <views:SettingsView DataContext="{Binding Selected.ViewModel, FallbackValue={x:Null}}" />
        </Border>
    </Grid>
</Window>
